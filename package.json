{
  "name": "skillfit",
  "version": "0.3.0",
  "description": "Evidence-driven configuration for AI coding agents: measure which skills, rules and MCP servers actually help — then install only those.",
  "type": "module",
  "bin": {
    "skillfit": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "benches",
    "evidence",
    "profiles",
    "skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remote-controlled-man/skillfit.git"
  },
  "homepage": "https://github.com/remote-controlled-man/skillfit#readme",
  "bugs": "https://github.com/remote-controlled-man/skillfit/issues",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "doctor": "npm run build && node dist/cli.js doctor",
    "check": "npm run build && node --test \"dist/**/*.test.js\"",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "ai-coding-agent",
    "agent-skills",
    "claude-code",
    "codex",
    "kimi-code",
    "mcp",
    "agents-md",
    "eval",
    "benchmark"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
