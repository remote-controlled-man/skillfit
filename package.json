{
  "name": "skillfit",
  "version": "0.13.1",
  "description": "Evidence-driven configuration for AI coding agents: measure which skills, rules and MCP servers actually help \u2014 then install only those.",
  "type": "module",
  "bin": {
    "skillfit": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/**/!(*.test).js",
    "dist/**/*.json",
    "dist/commands/bench-source.test.js",
    "dist/commands/bench-draft.test.js",
    "dist/commands/eval-layout.test.js",
    "dist/commands/eval-api-failure.test.js",
    "dist/harness/verifier-timeout.test.js",
    "dist/harness/bench-location.test.js",
    "benches",
    "docs",
    "profiles",
    "skills",
    "tools/verify/recipes/*.mjs",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remote-controlled-man/skillfit.git"
  },
  "homepage": "https://github.com/remote-controlled-man/skillfit#readme",
  "bugs": "https://github.com/remote-controlled-man/skillfit/issues",
  "scripts": {
    "build": "node tools/verify/build.mjs",
    "test": "npm run build && node --test \"dist/**/*.test.js\" \"tools/**/*.test.mjs\"",
    "doctor": "npm run build && node dist/cli.js doctor",
    "check": "npm run build && node --test \"dist/**/*.test.js\" \"tools/**/*.test.mjs\"",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "ai-coding-agent",
    "agent-skills",
    "claude-code",
    "codex",
    "kimi-code",
    "mcp",
    "agents-md",
    "eval",
    "benchmark"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
