diff --git a/src/money.js b/src/money.js
--- a/src/money.js
+++ b/src/money.js
@@ -1,3 +1,7 @@
 export function roundCents(value) {
   return Math.round(value * 100) / 100;
 }
+
+export function percentOff(amount, percent) {
+  return roundCents(amount * (percent / 100));
+}
diff --git a/src/order.js b/src/order.js
--- a/src/order.js
+++ b/src/order.js
@@ -10,4 +10,27 @@ export function orderTotal(items) {
     total += lineTotal(item);
   }
   return total;
 }
+
+// Returns a new list of items with bulk-discount pricing applied.
+export function applyBulkDiscount(items) {
+  const discounted = [];
+  if (items.length === 0) {
+    return discounted;
+  }
+
+  for (let i = 0; i < items.length; i++) {
+    const item = items[i];
+    if (item.qty < 0) {
+      throw new Error('invalid quantity: ' + item.qty);
+    }
+    let unitPrice = item.price;
+    if (item.qty === 0) {
+      unitPrice = 0;
+    } else if (item.qty > 10) {
+      unitPrice = roundCents(unitPrice * 0.95);
+    }
+    discounted.push({ ...item, price: unitPrice });
+  }
+  return discounted;
+}
