diff --git a/src/pricing.js b/src/pricing.js
--- a/src/pricing.js
+++ b/src/pricing.js
@@ -1,20 +1,36 @@
 import { roundCents } from './money.js';
 import { AppError } from './errors.js';
 
+const BULK_QTY = 10;
+const BULK_RATE = 0.05;
+
+// Resolves the unit price for a line: promotional price when present, otherwise list price.
+export function effectiveUnitPrice(line) {
+  let unit = line.price;
+  if (line.promoPrice != null) {
+    unit = Math.min(line.promoPrice, line.price);
+  }
+  if (line.qty >= BULK_QTY) {
+    unit = unit * (1 - BULK_RATE);
+  }
+  return unit;
+}
+
 export function lineAmount(line) {
   if (line.qty < 0) {
     throw new AppError('INVALID_QUANTITY', 'negative quantity');
   }
-  return line.price * line.qty;
+  return effectiveUnitPrice(line) * line.qty;
 }
 
 export function orderTotal(lines) {
-  if (lines.length === 0) {
-    throw new AppError('EMPTY_ORDER', 'cannot price an empty order');
-  }
   let total = 0;
   for (const line of lines) {
     total += lineAmount(line);
   }
   return roundCents(total);
 }
+
+export function formatOrder(lines) {
+  return orderTotal(lines).toFixed(2);
+}
