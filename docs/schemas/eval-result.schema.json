{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skillfit Agent evaluation response version 1",
  "type": "object",
  "required": ["schemaVersion", "kind", "status", "acceptance"],
  "properties": {
    "measurementScope": { "$ref": "measurement-scope.schema.json" },
    "schemaVersion": { "const": 1 },
    "kind": { "enum": ["skillfit.eval-result", "skillfit.eval-error"] },
    "status": { "enum": ["planned", "completed", "stopped", "incomplete", "reported", "error"] },
    "plan": { "type": "object", "required": ["sha256", "evaluation"], "properties": { "evaluation": { "type": "object", "properties": { "measurementScope": { "$ref": "measurement-scope.schema.json" } } } } },
    "manifest": { "type": ["object", "null"] },
    "casePreflight": { "anyOf": [{ "$ref": "eval-preflight.schema.json" }, { "type": "null" }] },
    "agentPreflight": { "anyOf": [{ "$ref": "agent-preflight.schema.json" }, { "type": "null" }] },
    "inputSnapshot": {
      "type": ["object", "null"],
      "required": ["schemaVersion", "indexPath", "sha256", "cost"],
      "properties": {
        "schemaVersion": { "const": 1 }, "indexPath": { "const": "_inputs.json" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "cost": { "type": "object", "required": ["modelCalls", "durationMs", "bytes", "files"],
          "properties": { "modelCalls": { "const": 0 }, "durationMs": { "type": "integer", "minimum": 0 }, "bytes": { "type": "integer", "minimum": 0 }, "files": { "type": "integer", "minimum": 0 } } }
      }
    },
    "identity": { "type": "object" },
    "diagnostics": { "type": "array", "items": { "type": "object", "required": ["taskId", "baselineBand", "qualityHeadroom", "efficiencyEligibility", "activationCoverage"] } },
    "quality": { "type": "object", "required": ["statisticalVerdict", "improvedPairs", "regressedPairs", "tasks"] },
    "costs": {
      "type": "object", "required": ["populations", "scope"],
      "properties": {
        "efficiency": {
          "type": "object", "required": ["metric", "method", "seed", "resamples", "tasksCompared", "point", "ci", "unavailableReason"],
          "properties": {
            "metric": { "const": "uncachedInput" },
            "method": { "const": "paired-task-percentile-bootstrap" },
            "seed": { "const": 20261013 }, "resamples": { "const": 10000 },
            "point": { "type": ["number", "null"] }, "ci": { "type": ["object", "null"] }
          }
        }
      }
    },
    "invocationCosts": { "anyOf": [{ "$ref": "invocation-costs.schema.json" }, { "type": "null" }] },
    "evidence": { "type": "object", "required": ["verified"] },
    "acceptance": {
      "type": "object", "required": ["decision", "eligibleForUpgrade", "automaticUpgrade"],
      "properties": {
        "decision": { "enum": ["accept", "reject", "inconclusive"] },
        "eligibleForUpgrade": { "type": "boolean" },
        "automaticUpgrade": { "const": false }
      },
      "allOf": [
        { "if": { "properties": { "decision": { "const": "accept" } } }, "then": { "properties": { "eligibleForUpgrade": { "const": true } } }, "else": { "properties": { "eligibleForUpgrade": { "const": false } } } }
      ]
    },
    "error": { "type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}, "allOf": [{"if": {"properties": {"code": {"const": "RECORDED_STATISTICS_NUMERIC_ERROR"}}}, "then": {"required": ["details"], "properties": {"details": {"$ref": "#/$defs/mcnemarNumericErrorDetails"}}}}]},
    "modelIdentities": {
      "$ref": "model-identities.schema.json"
    }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "planned" } } }, "then": { "required": ["plan"] } },
    { "if": { "properties": { "status": { "enum": ["completed", "reported"] } } }, "then": { "required": ["manifest", "identity", "quality", "costs", "evidence"] } },
    { "if": { "properties": { "kind": { "const": "skillfit.eval-error" } } }, "then": { "required": ["error"], "properties": { "status": { "const": "error" } } } }
  ],
  "$defs": {
    "mcnemarNumericErrorDetails": {
      "type": "object",
      "required": [
        "discordant",
        "recorded",
        "computed"
      ],
      "properties": {
        "discordant": {
          "type": "object",
          "required": [
            "improved",
            "regressed"
          ],
          "properties": {
            "improved": {
              "type": "integer",
              "minimum": 0
            },
            "regressed": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "recorded": {
          "$ref": "#/$defs/mcnemarResult"
        },
        "computed": {
          "$ref": "#/$defs/mcnemarResult"
        }
      }
    },
    "mcnemarResult": {
      "type": "object",
      "required": [
        "mcnemarP",
        "verdict"
      ],
      "properties": {
        "mcnemarP": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "verdict": {
          "enum": [
            "effective",
            "ineffective",
            "inconclusive"
          ]
        }
      }
    }
  }
}
