{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skillfit Agent evaluation request version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baselineSkill", "candidateSkill", "bench", "agent", "purpose", "trials", "maxCalls", "runsRoot", "runGroup"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baselineSkill": { "$ref": "#/$defs/path" },
    "candidateSkill": { "$ref": "#/$defs/path" },
    "bench": { "$ref": "#/$defs/path" },
    "agent": { "enum": ["codex", "claude-code", "kimi-code"] },
    "purpose": { "enum": ["development", "validation"] },
    "pairOrder": { "enum": ["baseline-first", "balanced"], "default": "baseline-first" },
    "executorTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600, "default": 600 },
    "trials": { "type": "integer", "minimum": 1, "maximum": 20 },
    "maxCalls": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "spendingBudget": {
      "type": "object", "additionalProperties": false,
      "required": ["input", "cachedInput", "uncachedInput", "output", "durationSeconds"],
      "properties": {
        "input": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "cachedInput": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "uncachedInput": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "output": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 9007199254740991 }
      }
    },
    "runsRoot": { "$ref": "#/$defs/path" },
    "runGroup": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "policy": { "$ref": "eval-policy.schema.json" }
  },
  "$defs": { "path": { "type": "string", "minLength": 1, "pattern": "\\S", "not": { "pattern": "\\u0000" } } }
}
