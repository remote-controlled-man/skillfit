{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skillfit bench manifests v1 and opt-in v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "tasks"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "name": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": [
        "id",
        "fixture",
        "prompt",
        "verifier"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "fixture": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "promptTrigger": {
          "type": "string",
          "minLength": 1
        },
        "verifier": {
          "type": "string",
          "minLength": 1
        },
        "oracle": {
          "type": "string",
          "minLength": 1
        },
        "rubric": {
          "type": "string",
          "minLength": 1
        },
        "verifierKind": {
          "enum": [
            "output",
            "command"
          ]
        },
        "verifierTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "shouldTrigger": {
          "type": "boolean"
        },
        "triggerClass": {
          "enum": [
            "explicit",
            "implicit",
            "contextual"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "triggerClass"
            ]
          },
          "then": {
            "required": [
              "shouldTrigger"
            ],
            "properties": {
              "shouldTrigger": {
                "const": true
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "tasks": {
            "items": {
              "required": [
                "claims"
              ],
              "properties": {
                "claims": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "quality",
                      "efficiency",
                      "activation"
                    ]
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "claims": {
                        "contains": {
                          "const": "activation"
                        }
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "shouldTrigger"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  ]
}
