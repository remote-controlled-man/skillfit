    readable event emitted right away when listened for
    
    Fix: https://github.com/isaacs/minipass/issues/36

diff --git a/index.js b/index.js
index fa2c694..76a7d5e 100644
--- a/index.js
+++ b/index.js
@@ -372,6 +372,8 @@ module.exports = class Minipass extends Stream {
     const ret = super.on(ev, fn)
     if (ev === 'data' && !this.pipes.length && !this.flowing)
       this[RESUME]()
+    else if (ev === 'readable' && this[BUFFERLENGTH] !== 0)
+      super.emit('readable')
     else if (isEndish(ev) && this[EMITTED_END]) {
       super.emit(ev)
       this.removeAllListeners(ev)
diff --git a/test/readable-emits-immediately.js b/test/readable-emits-immediately.js
new file mode 100644
index 0000000..821631e
--- /dev/null
+++ b/test/readable-emits-immediately.js
@@ -0,0 +1,14 @@
+// https://github.com/isaacs/minipass/issues/36
+const Minipass = require('../')
+const t = require('tap')
+
+const m = new Minipass({ encoding: 'utf8' })
+m.write('hello')
+t.equal(m.flowing, false)
+let readableEmitted = false
+m.on('readable', () => {
+  readableEmitted = true
+  m.on('data', c => t.equal(c, 'hello'))
+})
+t.equal(m.flowing, true)
+t.equal(readableEmitted, true)
