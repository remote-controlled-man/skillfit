diff --git a/test/async-duplicate-end.js b/test/async-duplicate-end.js
new file mode 100644
index 0000000..e636323
--- /dev/null
+++ b/test/async-duplicate-end.js
@@ -0,0 +1,20 @@
+const Minipass = require('../')
+const t = require('tap')
+
+t.test('async pipes should only end one time', t => {
+  const m = new Minipass({ async: true })
+  let ended = 0
+  const d = new Minipass()
+  d.end = () => {
+    ended++
+    Minipass.prototype.end.call(d)
+  }
+  m.pipe(d)
+  m.end()
+  m.end()
+  m.end()
+  setTimeout(() => {
+    t.equal(ended, 1)
+    t.end()
+  })
+})
