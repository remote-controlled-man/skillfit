+
+// Applies per-line tax and returns new lines sorted by taxed unit price, descending.
+export function applyLineTax(lines, taxRate) {
+  if (!taxRate || taxRate <= 0) {
+    throw new AppError('INVALID_RATE', 'taxRate must be positive');
+  }
+  const taxed = [];
+  for (const line of lines) {
+    if (line.qty < 0) {
+      throw new AppError('QTY_NEGATIVE', 'negative quantity');
+    }
+    const unitWithTax = roundCents(line.unitPrice * (1 + taxRate));
+    taxed.push({ ...line, unitPrice: unitWithTax });
+  }
+  taxed.sort((a, b) => b.unitPrice - a.unitPrice);
+  return taxed;
+}
+
+// Fills in missing quantities with the default of 1.
+export function normalizeQuantities(lines) {
+  for (const line of lines) {
+    if (line.qty == null) {
+      line.qty = 1;
+    }
+  }
+  return lines;
+}
